# Astra Coder configuration. Keep credentials out of the repository.
ASTRA_DATABASE_URL=sqlite:///./astra.db
ASTRA_LOG_LEVEL=INFO
ASTRA_BIND_HOST=127.0.0.1
ASTRA_BIND_PORT=8000
ASTRA_DEFAULT_MODEL=ollama/qwen2.5-coder
ASTRA_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Authentication defaults to required. The API never trusts caller-supplied roles.
ASTRA_AUTH_MODE=required
# For a local-only server principal, use ASTRA_AUTH_MODE=local with these values.
# ASTRA_LOCAL_ACTOR_ID=local-user
# ASTRA_LOCAL_ROLE=developer
# For an explicit local token map, use ASTRA_AUTH_MODE=tokens and provide JSON server-side.
# ASTRA_AUTH_TOKENS={"example-token":{"actor_id":"developer","role":"developer"}}
# Optional remote providers; leave unset for local-only operation.
# ASTRA_OPENAI_BASE_URL=https://api.openai.com/v1
# ASTRA_OPENAI_API_KEY=replace-me

# Stage 04b free cascade: Ollama -> NVIDIA NIM -> OpenRouter :free -> Groq.
# Keys are environment-only. Leave a key unset to disable that provider.
# ASTRA_NVIDIA_API_KEY=
# ASTRA_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# ASTRA_OPENROUTER_API_KEY=
# ASTRA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# ASTRA_GROQ_API_KEY=
# ASTRA_GROQ_BASE_URL=https://api.groq.com/openai/v1
ASTRA_FREE_CASCADE_ORDER=ollama,nvidia_nim,openrouter,groq
ASTRA_ALLOW_PAID_REMOTE=false
ASTRA_ALLOW_REMOTE_T4=false
ASTRA_REMOTE_TIMEOUT_SECONDS=60
ASTRA_RETRY_BACKOFF_SECONDS=0.5

# Opt-in Compose structured-plan worker; see docs/worker-demo.md.
# ASTRA_SOURCE_REPO=.
# ASTRA_WORKSPACE_VOLUME=astracoder-workspaces
# ASTRA_DOCKER_GID=0
# ASTRA_API_PORT=8000
# ASTRA_DASHBOARD_PORT=3000
# Dashboard authentication is server-side; set all four values outside Git.
# ASTRA_API_URL=http://api:8000
# ASTRA_DASHBOARD_ORIGIN=http://127.0.0.1:3000
# ASTRA_DASHBOARD_API_TOKEN=server-side-api-token
# ASTRA_DASHBOARD_LOGIN_TOKEN=server-side-login-token
# ASTRA_DASHBOARD_SESSION_SECRET=replace-with-at-least-32-random-characters
# ASTRA_DASHBOARD_COOKIE_SECURE=false
# ASTRA_DASHBOARD_SESSION_TTL_SECONDS=3600
