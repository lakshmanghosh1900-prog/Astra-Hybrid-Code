# Astra Coder configuration. Keep credentials out of the repository.
ASTRA_DATABASE_URL=sqlite:///./astra.db
ASTRA_LOG_LEVEL=INFO
ASTRA_BIND_HOST=127.0.0.1
ASTRA_BIND_PORT=8000
ASTRA_DEFAULT_MODEL=ollama/qwen2.5-coder
ASTRA_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional remote providers; leave unset for local-only operation.
# ASTRA_OPENAI_BASE_URL=https://api.openai.com/v1
# ASTRA_OPENAI_API_KEY=replace-me
