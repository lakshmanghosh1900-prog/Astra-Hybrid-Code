{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astracoder.local/schemas/authorization-log.schema.json",
  "title": "authorization-log",
  "description": "Proposed template-derived contract. Not proof of authorization, compliance, or evidence validity. Hash chain (event_sha256 over previous_event_hash) must be verified by an external verifier. Schema cannot prove chain integrity.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_type": {
      "const": "ASTRA_CODER_AUTHORIZATION_AUDIT_LOG"
    },
    "repository": {
      "const": "lakshmanghosh1900-prog/Astra-Hybrid-Code"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "event_type": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "const": "05b"
          },
          "actor_type": {
            "enum": [
              "HUMAN_OPERATOR",
              "SYSTEM_VERIFIER"
            ]
          },
          "actor_identity": {
            "type": [
              "string",
              "null"
            ]
          },
          "authorization_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "timestamp_utc": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "decision": {
            "enum": [
              "PENDING",
              "APPROVED",
              "REJECTED",
              "REVOKED"
            ]
          },
          "evidence_reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "previous_event_hash": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "event_sha256": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "event_id",
          "event_type",
          "stage",
          "actor_type",
          "actor_identity",
          "authorization_id",
          "timestamp_utc",
          "decision",
          "evidence_reference",
          "previous_event_hash",
          "event_sha256"
        ],
        "additionalProperties": false
      }
    },
    "integrity": {
      "type": "object",
      "properties": {
        "append_only": {
          "const": true
        },
        "tamper_evident": {
          "const": true
        },
        "hash_algorithm": {
          "const": "SHA-256"
        },
        "verified": {
          "type": "boolean"
        }
      },
      "required": [
        "append_only",
        "tamper_evident",
        "hash_algorithm",
        "verified"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "repository",
    "events",
    "integrity"
  ],
  "additionalProperties": false
}
